  "name": "mlaire-mlqa",
  "description": "\n\t\n\t\t\n\t\n\t\n\t\tMLAIRE-MLQA\n\t\n\nMLQA reformatted for language-aware retrieval evaluation. Passages are deduplicated at the context level via union-find on the original MLQA ids. Relevance is encoded by group_id matching.\nThis repository is part of the MLAIRE benchmark (NeurIPS 2026\nEvaluations & Datasets Track). Evaluation code: https://github.com/yjoonjang/MLAIRE\n\n\t\n\t\t\n\t\n\t\n\t\tDefault top-k\n\t\n\nReported metrics in the paper use top-20.\n\n\t\n\t\t\n\t\n\t\n\t\tLayout\n\t\n\ncorpus/test-*.parquet      _id, text, title… See the full description on the dataset page: https://huggingface.co/datasets/nlpai-lab/mlaire-mlqa.",
  "alternateName": [
    "nlpai-lab/mlaire-mlqa",
    "MLAIRE-MLQA"
  ],
  "creator": {
    "@type": "Organization",
    "name": "NLP & AI - Korea University",
    "url": "https://huggingface.co/nlpai-lab"
  },
  "keywords": [
    "text-retrieval",
    "multilingual",
    "English",
    "Arabic",
    "German",
    "Spanish",
    "Hindi",
    "Vietnamese",
    "Chinese",
    "cc-by-sa-3.0",
    "🇺🇸 Region: US",
    "retrieval",
    "multilingual",
    "language-aware-ir",
    "benchmark",
    "beir",
    "mlaire"
  ],
  "license": "CC BY-SA 3.0",
  "url": "https://huggingface.co/datasets/nlpai-lab/mlaire-mlqa",
  "citeAs": "@inproceedings{jang2026mlaire, title={{MLAIRE}: Multilingual Language-Aware Information Retrieval Evaluation Protocol}, author={Jang, Youngjoon and Hong, Seongtae and Moon, Hyeonseok and Lim, Heuiseok}, booktitle={Advances in Neural Information Processing Systems (NeurIPS), Evaluations and Datasets Track}, year={2026}}",
  "version": "1.0.0",
  "datePublished": "2026-11-03",
  "rai:hasSyntheticData": false,
  "rai:dataCollection": "Reorganized from the public MLQA (Lewis et al., 2020) release without new annotation. Passages expressing the same content in different languages are grouped into content groups; every query is linked to its content group, and each passage and query keeps its language label.",
  "rai:dataCollectionType": [
    "Secondary Data Analysis"
  ],
  "rai:dataPreprocessingProtocol": "Passages and queries are taken verbatim from the source release and exported in BEIR format (corpus, queries, qrels). Relevance is binary group membership.",
  "rai:dataUseCases": "Evaluating multilingual retrievers on cross-lingual semantic retrieval and on query-language preference (LPR, Lang-nDCG, top-1 4-way decomposition).",
  "rai:dataLimitations": "QA-style parallel passages may not represent open-domain mixed-language corpora. Language coverage is uneven across families, scripts, and resource levels. Query-language preference is not a universal utility measure.",
  "rai:dataBiases": "High-resource languages and translated benchmark content may be overrepresented relative to naturally occurring multilingual search.",
  "rai:personalSensitiveInformation": "None added. Content is inherited from the public source dataset.",
  "rai:dataSocialImpact": "Intended as a diagnostic for whether retrievers return evidence in the query language. Optimizing language preference in isolation may hide more complete cross-lingual evidence. Source license: CC BY-SA 3.0; follow its attribution and share-alike terms."
}